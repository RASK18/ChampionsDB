      "id": "stat-calculation",
      "name": "Cálculo de estadísticas",
      "value": {
        "description": "Fórmulas normales de Champions; se excluye la variante opcional de Showdown con nivel configurable.",
        "exceptionsComplete": false,
        "hpFormula": "PS = PS base + puntos de PS + 75",
        "natureBoostMultiplier": 1.1,
        "natureDropMultiplier": 0.9,
        "natureNeutralMultiplier": 1,
        "statFormula": "Característica = suelo((base + puntos + 20) × naturaleza)"
      }
    },
