      "id": "damage-calculation",
      "name": "Cálculo de daño",
      "value": {
        "baseFormula": "B = suelo(suelo(suelo(2 × nivel / 5 + 2) × potencia × ataque / defensa) / 50) + 2",
        "description": "Ataque/Defensa para movimientos físicos; Ataque Especial/Defensa Especial para especiales, salvo sustituciones del movimiento. Los modificadores se aplican sucesivamente con redondeos del motor; la fórmula base no es un simulador completo.",
        "exceptionsComplete": false,
        "modifierOrder": [
          "objetivos múltiples",
          "clima",
          "golpe crítico",
          "azar",
          "mismo tipo",
          "efectividad",
          "quemadura",
          "modificadores finales"
        ],
        "randomMaximumPercent": 100,
        "randomMinimumPercent": 85,
        "randomOutcomes": 16,
        "spreadMultiplier": 0.75,
        "stabMultiplier": 1.5
      }
    },
